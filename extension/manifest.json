{
  "manifest_version": 3,
  "name": "SvizzGPT Chrome Overlay",
  "version": "1.0.0",
  "description": "Floating draggable AI overlay over every Chrome tab and window.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Toggle SvizzGPT Overlay (Ctrl+Space / Cmd+Space)"
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle SvizzGPT Overlay"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_end"
    }
  ]
}
