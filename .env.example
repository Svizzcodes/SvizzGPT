# ============================================================
# SVIZZGPT ENVIRONMENT CONFIGURATION (MULTI-PROVIDER)
# ============================================================

# 1. CORE AI PROVIDERS (ALL INTEGRATED & SUPPORTED)
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_or_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. MODEL CONFIGURATION
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# 3. DATABASE CONFIGURATION (Defaults to SQLite)
DATABASE_URL=sqlite:///./svizzgpt.db

# 4. SERVER CONFIGURATION
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 5. OPTIONAL WEB SEARCH
TAVILY_API_KEY=
